---
import { SHOW_SIGNUP_CTA, SIGNUP_URL, CTA_PRIMARY, CTA_SECONDARY } from '../data/site';

interface Props {
  title?: string;
  note?: string;
  chips?: string[];
}
const {
  title = 'Put your next route on MLogTech.',
  note = SHOW_SIGNUP_CTA
    ? `See it against your own data first, or start right away.`
    : `See it against your own data first.`,
  chips = SHOW_SIGNUP_CTA
    ? [
        'Free trial, no card required',
        'Set up in minutes, not weeks',
        'Your data exports anytime',
      ]
    : [
        'From login to a published route in under a minute',
        'Import orders from CSV or API',
        'Per-driver or per-order pricing',
      ],
} = Astro.props;
---

<!-- Deliberate fixed-dark band: the one drenched moment per page, identical
     in light and dark. Colors come from the theme-independent fixed-* tokens. -->
<section class="section bg-[color:var(--fixed-dark)]">
  <div class="wrap text-center">
    <h2 class="h2 reveal mx-auto max-w-[24ch] text-[color:var(--fixed-ink)]">{title}</h2>
    <p class="reveal mx-auto mt-4 max-w-[52ch] text-[color:var(--fixed-body)]">{note}</p>
    <div class="reveal mt-8 flex flex-wrap justify-center gap-3">
      {SHOW_SIGNUP_CTA && <a href={SIGNUP_URL} class="btn btn-primary">{CTA_PRIMARY}</a>}
      <a
        href="/demo/"
        class:list={[
          'btn',
          SHOW_SIGNUP_CTA
            ? 'btn-ghost border-[color:var(--fixed-hair)] text-[color:var(--fixed-ink)] hover:border-accent'
            : 'btn-primary',
        ]}
        >{CTA_SECONDARY}</a
      >
    </div>
    {
      chips.length > 0 && (
        <ul
          data-testid="cta-chips"
          class="reveal mx-auto mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-[0.9rem] text-[color:var(--fixed-body)]"
        >
          {chips.map((chip) => (
            <li class="flex items-center gap-2">
              <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M3 8.5 6.5 12 13 4.5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              {chip}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

---
import Base from '../layouts/Base.astro';
import RouteMap from '../components/RouteMap.astro';
import TrustStrip from '../components/TrustStrip.astro';
import StatStrip from '../components/StatStrip.astro';
import CTABanner from '../components/CTABanner.astro';
import {
  SHOW_SIGNUP_CTA,
  SIGNUP_URL,
  CTA_PRIMARY,
  CTA_SECONDARY,
  SITE_NAME,
  MEASURED_LOGIN_TO_ROUTE_CLAIM,
} from '../data/site';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE_NAME,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, iOS, Android',
  description:
    'Delivery management software with electronic proof of delivery, live tracking and route optimisation.',
};

const solutionPoints = [
  {
    title: 'Stop paying twice for the same delivery',
    body: 'Routes are built around real delivery windows, and any stop at risk of missing its deadline is flagged to the driver in time to act. When one does fail, the reason and the photo reach the office while the van is still out, so you can plan the redelivery the same day.',
  },
  {
    title: 'Proof on every parcel, in seconds',
    body: 'Photo, signature, the name of who signed for it, location, time and barcode scan, all attached to the order automatically. Settle an invoice dispute by sending a link, instead of spending an afternoon going through gloveboxes.',
  },
  {
    title: 'Your customers stop calling',
    body: 'Recipients get a tracking page branded in your client’s name, with a live ETA and an email when the parcel is out for delivery and again when it arrives. Your office stops being a call centre for delivery status.',
  },
];

const steps = [
  {
    title: 'Import your orders',
    body: 'Upload a spreadsheet or connect the API. Orders land on the dispatch board with addresses validated.',
  },
  {
    title: 'Optimise the routes',
    body: 'One click builds the day’s routes against vehicles, time windows and capacity. Adjust by drag and drop.',
  },
  {
    title: 'Drivers execute in the app',
    body: 'Each driver gets their route with navigation and order details, online or offline.',
  },
  {
    title: 'Proof closes the loop',
    body: 'Signature, photo and timestamp are captured at the door, and the POD lands on the order instantly, ready to share with the customer.',
  },
];
---

<Base
  title="MLogTech | Delivery management software with electronic proof of delivery"
  description="Plan optimised routes, run deliveries with a driver app, capture electronic proof of delivery and give customers live tracking. Built by MLogTech."
  jsonLd={[softwareSchema]}
>
  <!-- 1. Hero: the "One system." payoff is the dominant beat, now set over the
       depot photograph (the fleet the software runs). Fixed navy scrim keeps the
       text at AA in both themes; the fixed-* tokens are the same ones the CTA
       band uses. Emphasis by size/weight only (no hi-vis on text). -->
  <section class="hero-photo relative overflow-hidden border-b border-hair">
    <img
      src="/images/hero-depot-2560.jpg"
      srcset="/images/hero-depot-1280.jpg 1280w, /images/hero-depot-2560.jpg 2560w"
      sizes="100vw"
      alt=""
      width="2560"
      height="853"
      fetchpriority="high"
      decoding="async"
      class="hero-photo-img absolute inset-0 h-full w-full object-cover"
    />
    <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative flex min-h-[560px] items-center py-20 lg:min-h-[640px] lg:py-24">
      <div class="reveal max-w-[640px]">
        <h1 class="text-balance">
          <span class="block text-[clamp(1.5rem,2.6vw,2.15rem)] font-semibold leading-tight text-[color:var(--fixed-body)]">
            Proof of delivery, live tracking, optimised routes.
          </span>
          <span class="mt-3 block font-extrabold leading-[0.98] tracking-[-0.03em] text-[color:var(--fixed-ink)] text-[clamp(3.25rem,8vw,5.5rem)]">
            One system.
          </span>
        </h1>
        <p class="lead mt-6 max-w-[54ch] text-[color:var(--fixed-body)]">
          {MEASURED_LOGIN_TO_ROUTE_CLAIM}, measured on a live
          operation. £200k+ in driver pay and 5,600+ shifts already run through the
          same system: route planning, a native driver app, proof of delivery,
          customer tracking, workforce and pay, compliance, fleet and CRM.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          {SHOW_SIGNUP_CTA && <a href={SIGNUP_URL} class="btn btn-primary" data-umami-event="cta-signup" data-umami-event-position="hero">{CTA_PRIMARY}</a>}
          <a
            href="/demo/"
            class:list={[
              'btn',
              SHOW_SIGNUP_CTA
                ? 'btn-ghost border-[color:var(--fixed-hair)] text-[color:var(--fixed-ink)] hover:border-accent'
                : 'btn-primary',
            ]}
            data-umami-event="cta-demo"
            data-umami-event-position="hero"
          >{CTA_SECONDARY}</a>
        </div>
        {SHOW_SIGNUP_CTA && <p class="mt-4 text-[0.9rem] text-[color:var(--fixed-body)]">Free trial. No card required.</p>}
      </div>
    </div>
  </section>

  <!-- 2. Social proof -->
  <TrustStrip />
  <StatStrip />

  <!-- 3. Solutions -->
  <section class="section">
    <div class="wrap">
      <h2 class="h2 reveal max-w-[24ch]">Our solutions:</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {
          solutionPoints.map((p) => (
            <div class="reveal border-t-2 border-hair-strong pt-5">
              <h3 class="h3">{p.title}</h3>
              <p class="mt-3 text-[1.02rem]">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Three pillars -->
  <section class="section bg-surface-2">
    <div class="wrap">
      <div class="reveal max-w-[60ch]">
        <h2 class="h2">Plan it. Run it. Prove it.</h2>
        <p class="lead mt-4">
          Planning, execution and proof usually live in separate tools. Here they share one record
          per order.
        </p>
      </div>
      <!-- Bento: the execution tile (driver app + ePOD, the core) is the
           focal panel; Plan and Track stack beside it. De-numbered: these are
           parallel capabilities. Each card carries the image of where it leads,
           behind a dark scrim. -->
      <div class="mt-10 grid gap-6 lg:grid-cols-2 lg:grid-rows-2">
        <!-- Focal tile: driver app + ePOD, the capability the system closes on. -->
        <a
          href="/solutions/driver-app/"
          class="reveal group relative isolate flex flex-col justify-end overflow-hidden rounded-[var(--r)] border border-white/12 bg-[color:var(--fixed-dark)] p-8 shadow-[var(--shadow-lg)] transition-transform duration-200 hover:-translate-y-1 lg:row-span-2 lg:p-10"
        >
          <img
            src="/images/pod-signature-capture.webp"
            alt=""
            aria-hidden="true"
            loading="lazy"
            class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[color:var(--fixed-dark)] via-[color:var(--fixed-dark)]/85 to-[color:var(--fixed-dark)]/45" />
          <h3 class="text-[color:var(--fixed-ink)] text-[clamp(1.5rem,2.4vw,2rem)] font-bold leading-tight">
            Execute at the door.
          </h3>
          <p class="mt-4 max-w-[38ch] text-[1.02rem] text-[color:var(--fixed-body)]">
            Drivers run the route in the app: navigation, order details, then signature, photo
            and barcode capture at the door. Proof lands on the order the moment it happens.
          </p>
          <span class="mt-6 font-semibold text-accent transition-transform duration-200 group-hover:translate-x-1">
            Driver app and ePOD &rarr;
          </span>
        </a>
        <a
          href="/solutions/route-planning/"
          class="reveal group relative isolate flex min-h-[200px] flex-col justify-end overflow-hidden rounded-[var(--r)] border border-white/12 bg-[color:var(--fixed-dark)] p-7 shadow-[var(--shadow-lg)] transition-transform duration-200 hover:-translate-y-1"
        >
          <img
            src="/images/product/panel-dashboard.jpg"
            alt=""
            aria-hidden="true"
            loading="lazy"
            class="absolute inset-0 -z-10 h-full w-full object-cover object-left-top transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[color:var(--fixed-dark)] via-[color:var(--fixed-dark)]/85 to-[color:var(--fixed-dark)]/45" />
          <h3 class="h3 text-[color:var(--fixed-ink)]">Plan the day in minutes.</h3>
          <p class="mt-3 text-[1.02rem] text-[color:var(--fixed-body)]">
            Import orders and build optimised multi-stop routes, matched to vehicles and shifts.
          </p>
          <span class="mt-5 font-semibold text-[color:var(--fixed-link)] transition-transform duration-200 group-hover:translate-x-1">
            Route planning &rarr;
          </span>
        </a>
        <a
          href="/features/live-tracking/"
          class="reveal group relative isolate flex min-h-[200px] flex-col justify-end overflow-hidden rounded-[var(--r)] border border-white/12 bg-[color:var(--fixed-dark)] p-7 shadow-[var(--shadow-lg)] transition-transform duration-200 hover:-translate-y-1"
        >
          <img
            src="/images/product/panel-tracking.jpg"
            alt=""
            aria-hidden="true"
            loading="lazy"
            class="absolute inset-0 -z-10 h-full w-full object-cover object-left-top transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[color:var(--fixed-dark)] via-[color:var(--fixed-dark)]/85 to-[color:var(--fixed-dark)]/45" />
          <h3 class="h3 text-[color:var(--fixed-ink)]">Track it to the door.</h3>
          <p class="mt-3 text-[1.02rem] text-[color:var(--fixed-body)]">
            You watch every vehicle live; your customer follows their delivery on a branded page.
          </p>
          <span class="mt-5 font-semibold text-[color:var(--fixed-link)] transition-transform duration-200 group-hover:translate-x-1">
            Tracking and reports &rarr;
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. How it works: the route spine. This is the page's structural motif,
       one order followed down the route, the hi-vis line as its backbone. -->
  <section class="section">
    <div class="wrap">
      <h2 class="reveal max-w-[20ch] text-[clamp(2rem,4vw,3.25rem)] font-extrabold leading-[1.03] tracking-[-0.02em]">
        Follow one order down the whole route.
      </h2>
      <p class="lead reveal mt-4">
        Four steps, one record. The same order you import is the one your customer signs for.
      </p>
      <ol class="relative mt-14 grid gap-10 md:grid-cols-4">
        <div
          class="absolute left-[11px] top-[11px] hidden h-[3px] bg-accent md:block"
          style="right: calc((100% - 7.5rem) / 4 - 11px)"
          aria-hidden="true"
        >
        </div>
        {
          steps.map((s, i) => (
            <li class="reveal relative md:pt-12">
              <span
                class="absolute left-0 top-0 hidden h-[22px] w-[22px] items-center justify-center rounded-full border-4 border-bg bg-accent shadow-[0_0_0_1px_var(--accent)] md:flex"
                aria-hidden="true"
              >
                <span class="data text-[0.75rem] font-bold text-accent-ink">{i + 1}</span>
              </span>
              <span class="data text-[0.8rem] text-accent-text md:hidden">Step {i + 1}</span>
              <h3 class="h3 mt-2 md:mt-0">{s.title}</h3>
              <p class="mt-2 max-w-[34ch] text-[0.95rem]">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. Feature spotlight: ePOD -->
  <section class="section bg-surface-2" id="epod">
    <div class="wrap grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal order-2 lg:order-1">
        <figure
          class="overflow-hidden rounded-[var(--r-lg)] border border-hair bg-surface shadow-[var(--shadow-lg)]"
        >
          <img
            src="/images/pod-signature-capture.webp"
            alt="A customer signing for a delivery on the driver's phone, which shows a delivery notification with a barcode and signature pad, as the courier hands over a parcel marked fragile"
            width="1325"
            height="885"
            loading="lazy"
            class="block w-full"
          />
        </figure>
      </div>
      <div class="reveal order-1 lg:order-2">
        <h2 class="h2">Proof of delivery that holds up.</h2>
        <p class="mt-4 text-[1.02rem]">
          Signature, photo and barcode scan captured at the door, stamped with time and location.
          The POD syncs the moment it happens and works offline when the signal does not.
        </p>
        <ul class="mt-6 space-y-3 text-[1.02rem]">
          <li class="flex gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
            Electronic signature and photo proof on every drop
          </li>
          <li class="flex gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
            QR and barcode scanning against the order
          </li>
          <li class="flex gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
            Offline capture with automatic sync
          </li>
        </ul>
        <a href="/features/proof-of-delivery/" class="textlink mt-6 inline-block"
          >More on electronic POD</a
        >
      </div>
    </div>
  </section>

  <!-- 7. Feature spotlight: tracking -->
  <section class="section">
    <div class="wrap grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal">
        <h2 class="h2">Your customer stops calling. They can see the van.</h2>
        <p class="mt-4 text-[1.02rem]">
          Every order gets a live tracking page with your brand on it: position, ETA and status.
          Notifications go out automatically at dispatch, en route and delivered.
        </p>
        <ul class="mt-6 space-y-3 text-[1.02rem]">
          <li class="flex gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
            Branded tracking page per delivery
          </li>
          <li class="flex gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
            Live ETA recalculated on the road
          </li>
          <li class="flex gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
            Email and push notifications per status
          </li>
        </ul>
        <a href="/features/live-tracking/" class="textlink mt-6 inline-block"
          >More on live tracking</a
        >
      </div>
      <div class="reveal relative pb-10 sm:pb-6 lg:pb-8">
        <RouteMap />
        <!-- The same live location, seen from the cab: a real hand on a phone
             overlapping the tracking map to make "they can see the van" literal. -->
        <img
          src="/images/live-tracking-phone.jpg"
          alt="A person in a vehicle following a delivery's live location on a map on their phone"
          width="1000"
          height="666"
          loading="lazy"
          class="absolute bottom-[-6%] left-[3%] z-10 w-[40%] max-w-[250px] -rotate-[3deg] rounded-[var(--r)] border-4 border-surface bg-surface shadow-[var(--shadow-lg)] ring-1 ring-black/5"
        />
      </div>
    </div>
  </section>

  <!-- 8. Beyond the route: the driver operation a pure router won't run.
       Real differentiators from the product catalogue, shown with two real
       driver-app screens (onboarding + pay). -->
  <section class="section bg-surface-2">
    <div class="wrap grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <!-- The people running the operation (dispatch and back office) with the
           driver app in front: the half of the job a routing tool never touches. -->
      <div class="reveal relative pb-[15%] sm:pb-[10%] lg:pb-[8%]">
        <figure
          class="overflow-hidden rounded-[var(--r-lg)] border border-hair shadow-[var(--shadow-lg)]"
        >
          <img
            src="/images/ops-team-dispatch.jpg"
            alt="An operations team at their desks with headsets, coordinating deliveries on screen"
            width="1100"
            height="733"
            loading="lazy"
            class="block w-full"
          />
        </figure>
        <img
          src="/images/product/app-onboarding.png"
          alt="MLogTech driver app: guided onboarding, step 1 of 8, pick your place"
          width="414"
          height="852"
          loading="lazy"
          class="absolute bottom-[-9%] left-[6%] z-10 w-[25%] max-w-[132px] -rotate-[5deg] rounded-[1.1rem] border border-hair-strong bg-surface shadow-[var(--shadow-lg)] ring-1 ring-black/5"
        />
        <img
          src="/images/product/app-payments.png"
          alt="MLogTech driver app: weekly driver pay with pending and paid statements"
          width="405"
          height="832"
          loading="lazy"
          class="absolute bottom-[-5%] left-[31%] z-20 w-[25%] max-w-[132px] rotate-[4deg] rounded-[1.1rem] border border-hair-strong bg-surface shadow-[var(--shadow-lg)] ring-1 ring-black/5"
        />
      </div>
      <div class="reveal">
        <h2 class="h2 max-w-[20ch]">A pure router stops at the depot gate.</h2>
        <p class="lead mt-4">
          MLogTech also runs the people, compliance and vehicles behind every route, in the same
          system. That is what a routing tool alone will not do.
        </p>
        <div class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2">
          <div>
            <h3 class="text-[1.02rem] font-bold text-ink">Onboarding &amp; compliance</h3>
            <p class="mt-1 text-[0.95rem]">
              An 8-step first run captures documents, right-to-work and a DVLA licence check, with
              training records kept per driver.
            </p>
          </div>
          <div>
            <h3 class="text-[1.02rem] font-bold text-ink">Workforce &amp; pay</h3>
            <p class="mt-1 text-[0.95rem]">
              Schedules turn into driver invoices; the app shows pay as pending, flips it to paid
              on the date, and holds the official payslip.
            </p>
          </div>
          <div>
            <h3 class="text-[1.02rem] font-bold text-ink">Fleet &amp; maintenance</h3>
            <p class="mt-1 text-[0.95rem]">
              A full vehicle registry with inspections, insurance renewals, service reminders and
              odometer history.
            </p>
          </div>
          <div>
            <h3 class="text-[1.02rem] font-bold text-ink">Safety &amp; incidents</h3>
            <p class="mt-1 text-[0.95rem]">
              Drivers log accidents and vehicle damage from the road; offences and quality roll up
              in one view.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Integrations -->
  <section class="section">
    <div class="wrap">
      <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="reveal max-w-[52ch]">
          <h2 class="h2">Your orders already live somewhere. Bring them in.</h2>
          <p class="lead mt-4">
            Import from spreadsheets today, connect your stack through the API, and use native
            integrations as the catalogue rolls out.
          </p>
        </div>
        <figure
          class="reveal aspect-[3/2] overflow-hidden rounded-[var(--r-lg)] border border-hair shadow-[var(--shadow-lg)]"
        >
          <img
            src="/images/integrations-network.jpg"
            alt="A stylised 3D lorry on a glowing map, its delivery routes and stops drawn as a connected network"
            width="1024"
            height="1024"
            loading="lazy"
            class="block h-full w-full object-cover"
          />
        </figure>
      </div>
      <!-- One panel, two available-now columns split by a hairline, with the
           rollout note as a footer row. Distinct from the card grids above. -->
      <div class="reveal mt-10 overflow-hidden rounded-[var(--r-lg)] border border-hair bg-surface">
        <div class="grid gap-px bg-hair sm:grid-cols-2">
          <div class="bg-surface p-8">
            <span class="data text-[0.75rem] text-accent-text">Available now</span>
            <h3 class="h3 mt-2">Spreadsheets and CSV</h3>
            <p class="mt-2 text-[0.95rem]">
              Upload the day's orders exactly as they come from your ERP export.
            </p>
          </div>
          <div class="bg-surface p-8">
            <span class="data text-[0.75rem] text-accent-text">Available now</span>
            <h3 class="h3 mt-2">REST API and webhooks</h3>
            <p class="mt-2 text-[0.95rem]">
              Push orders in, get PODs and status events back, keyed to your own IDs.
            </p>
          </div>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-hair px-8 py-5">
          <p class="text-[0.95rem]">
            Native connectors for e-commerce and ERP platforms are in rollout.
          </p>
          <a class="textlink shrink-0" href="/integrations/">See the integration paths &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. Final CTA -->
  <CTABanner />
</Base>

<style>
  /* Fixed navy scrim over the depot photo: dense behind the text column,
     easing off toward the sunrise so the photograph still reads. Literal
     colors (like the CTA band), identical in light and dark themes. */
  .hero-scrim {
    background: linear-gradient(
      96deg,
      rgba(7, 20, 32, 0.9) 0%,
      rgba(7, 20, 32, 0.74) 36%,
      rgba(7, 20, 32, 0.36) 64%,
      rgba(7, 20, 32, 0.14) 100%
    );
  }
  .hero-photo-img {
    object-position: 50% 50%;
  }
  /* Portrait crop of a 3:1 photograph: favour the driver and the sunrise,
     and let the scrim run top-down since the text spans the full width. */
  @media (max-width: 1023px) {
    .hero-photo-img {
      object-position: 66% 50%;
    }
    .hero-scrim {
      background: linear-gradient(
        180deg,
        rgba(7, 20, 32, 0.88) 0%,
        rgba(7, 20, 32, 0.66) 60%,
        rgba(7, 20, 32, 0.4) 100%
      );
    }
  }
</style>
